{
  "name": "cs2-analyzer-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --ext .ts,.vue src",
    "format": "prettier --write \"src/**/*.{ts,vue,css,md}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "echarts": "^5.5.0",
    "lucide-vue-next": "^0.379.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.27",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.25.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.4.5",
    "vite": "^5.2.10",
    "vitest": "^1.5.0",
    "vue-tsc": "^2.0.14"
  }
}
