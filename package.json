{
  "name": "cs2-analyzer",
  "version": "0.1.2",
  "private": true,
  "description": "CS2 Demo Analyzer — FastAPI + Vue 3 + SQLite + demoparser2",
  "type": "module",
  "scripts": {
    "dev": "cd frontend && pnpm dev",
    "dev:backend": "uvicorn backend.main:app --reload",
    "dev:frontend": "cd frontend && pnpm dev",
    "build:frontend": "cd frontend && pnpm build",
    "lint": "pnpm lint:js && pnpm lint:py",
    "lint:js": "cd frontend && pnpm lint",
    "lint:py": "cd backend && ruff check . && ruff format --check .",
    "format": "pnpm format:js && pnpm format:py",
    "format:js": "cd frontend && pnpm format",
    "format:py": "cd backend && ruff format .",
    "test": "pnpm test:py && pnpm test:js",
    "test:py": "cd backend && pytest",
    "test:js": "cd frontend && pnpm test",
    "typecheck": "cd frontend && pnpm typecheck",
    "tools:extract-maps": "python tools/extract_maps.py"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.18",
    "pnpm": ">=8.0",
    "python": ">=3.11"
  },
  "packageManager": "pnpm@9.0.0"
}
