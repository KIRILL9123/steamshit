{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CS2 Analyzer",
  "version": "0.1.0",
  "identifier": "com.cs2analyzer.app",
  "build": {
    "beforeDevCommand": "npx pnpm --dir frontend dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npx pnpm --dir frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CS2 Analyzer",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Local CS2 demo analytics",
    "longDescription": "Local CS2 demo analytics — import, statistics, 2D replay, heatmaps, anticheat heuristics, AI coaching.",
    "copyright": "Copyright (c) 2026 CS2 Analyzer Team",
    "externalBin": [
      "binaries/python_sidecar"
    ],
    "resources": [
      "../frontend/dist",
      "../frontend/dist/assets"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
